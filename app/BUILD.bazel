load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("//bazel:flyte.bzl", "flyte_cli", "flyte_run", "flyte_deploy", "flyte_build")

py_binary(
    name = "main",
    srcs = ["main.py"],
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
)

# Entrypoint target - run with: bazel run //app:entrypoint -- "YourCustomString"
py_binary(
    name = "entrypoint",
    srcs = ["main.py"],
    main = "main.py",
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
    args = [],  # Default args can be set here, or passed at runtime
)

# Flyte CLI rule target - can be used with any flyte command
flyte_cli(
    name = "flyte",
)

# Flyte run rule - run the main task locally
flyte_run(
    name = "run_main_local",
    task_file = "main.py",
    task_function = "main",
    mode = "local",
    log_level = 10,  # DEBUG level for detailed logging
    params = ["x='Bazel'", "count=3"],
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
)

# Flyte run rule - run the main task remotely
flyte_run(
    name = "run_main_remote",
    task_file = "main.py",
    task_function = "main",
    mode = "remote",
    log_level = 10,  # DEBUG level for detailed logging
    params = ["x='Bazel Remote'", "count=2"],
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
)

# Flyte deploy rule - deploy the test environment
flyte_deploy(
    name = "deploy_test_env",
    env_file = "main.py",
    env_name = "test",
    dryrun = False,
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
)

# Flyte build rule - build images for the test environment
flyte_build(
    name = "build_test_env",
    env_file = "main.py",
    env_name = "test",
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
)

py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    deps = [
        ":main"
    ],
    imports = ["."],
)

compile_pip_requirements(
    name = "requirements",
    requirements_in = "requirements.txt",
    requirements_txt = "requirements_lock.txt",
)
