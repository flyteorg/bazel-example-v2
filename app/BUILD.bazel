load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("//bazel:flyte.bzl", "flyte_cli")

py_binary(
    name = "main",
    srcs = ["main.py"],
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
)

# Entrypoint target - run with: bazel run //app:entrypoint -- "YourCustomString"
py_binary(
    name = "entrypoint",
    srcs = ["main.py"],
    main = "main.py",
    deps = [
        "//package:hello",
        requirement("termcolor"),
        requirement("flyte"),
    ],
    args = [],  # Default args can be set here, or passed at runtime
)

# Flyte CLI rule target - can be used with any flyte command
flyte_cli(
    name = "flyte",
)

py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    deps = [
        ":main"
    ],
    imports = ["."],
)

compile_pip_requirements(
    name = "requirements",
    requirements_in = "requirements.txt",
    requirements_txt = "requirements_lock.txt",
)
