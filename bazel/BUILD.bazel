load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rules_python//python:defs.bzl", "py_binary")
load("@pip//:requirements.bzl", "requirement")

# Bundled Flyte CLI entry point that ships with the rule
py_binary(
    name = "_flyte_cli_bin",
    srcs = ["flyte_cli.py"],
    deps = [
        requirement("flyte"),
    ],
    main = "flyte_cli.py",
    visibility = ["//visibility:public"],
)

# Shared runner logic used by flyte_run / flyte_deploy / flyte_build macros
py_library(
    name = "_flyte_runner_lib",
    srcs = ["flyte_runner.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        requirement("flyte"),
    ],
)
